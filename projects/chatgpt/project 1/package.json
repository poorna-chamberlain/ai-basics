{
  "name": "quickimage",
  "version": "1.0.0",
  "description": "A native image search, editing, and clipboard launcher",
  "main": "./out/main/index.js",
  "author": "QuickImage",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "check:network": "electron scripts/network-check.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:app": "electron-vite build",
    "build": "npm run typecheck && npm run build:app && electron-builder --mac dmg && electron-builder --win nsis --x64",
    "build:mac": "npm run typecheck && npm run build:app && electron-builder --mac dmg",
    "build:win": "npm run typecheck && npm run build:app && electron-builder --win nsis --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.quickimage.app",
    "productName": "QuickImage",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
