# QuickImage — optional local development configuration.
#
# QuickImage works with NO configuration at all: Wikimedia Commons is the
# default image source and needs no key. This file only matters if you want to
# develop against the optional Google Custom Search provider.
#
# Copy to `.env` and fill in your own values. Never commit `.env`.
#
# These are read by the main process at startup and used as the initial value
# for the matching Settings fields when those are still empty. Anything you type
# in the Settings panel takes precedence and is what gets persisted.
#
#   API key:          https://developers.google.com/custom-search/v1/overview
#   Search engine ID: https://programmablesearchengine.google.com/controlpanel/all

MAIN_VITE_GOOGLE_API_KEY=
MAIN_VITE_GOOGLE_CX=
